# Required in production. Obtain from BotFather; never commit a real token.
BOT_TOKEN=
PORT=3000
HOST=0.0.0.0
MAX_ROOMS=20
ROOM_TTL_MS=21600000
ALLOWED_ORIGINS=http://localhost:3000

# Set to 1 only for local development without Telegram. Never enable in production.
ALLOW_DEV_AUTH=0

# Change ALLOWED_ORIGINS to the exact HTTPS origin of the deployed Mini App before production.
