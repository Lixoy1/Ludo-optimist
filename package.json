{
  "name": "optimist-ludo",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "OPTIMIST LUDO 2.0 — Classic, HEXA and ROYAL boards with an authoritative multiplayer engine",
  "scripts": {
    "test": "node --test",
    "start": "node --env-file-if-exists=.env apps/backend/server.js",
    "dev": "node --env-file-if-exists=.env --watch apps/backend/server.js",
    "smoke": "node --env-file-if-exists=.env scripts/server-smoke.mjs",
    "build:boards": "node scripts/build-board-assets.mjs",
    "build:extended-boards": "node scripts/build-extended-boards.js",
    "start:local": "node --env-file-if-exists=.env.local apps/backend/server.js",
    "build": "npm run build:boards && npm run build:extended-boards && npm run export:coordinates",
    "export:coordinates": "node scripts/export-coordinate-map.mjs"
  },
  "engines": {
    "node": ">=22.9.0"
  },
  "dependencies": {
    "ws": "^8.18.0"
  }
}
