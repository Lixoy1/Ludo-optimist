{
  "name": "optimist-ludo",
  "version": "0.6.0",
  "private": true,
  "type": "module",
  "description": "OPTIMIST LUDO integrated Classic Mini App, authoritative multiplayer backend and room voice chat",
  "scripts": {
    "test": "node --test",
    "start": "node --env-file-if-exists=.env apps/backend/server.js",
